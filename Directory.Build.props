<Project>

  <!--
    Shared MSBuild configuration for every mod in this workspace.

    Mod .csproj files under Mods/<ModName>/ inherit these settings automatically
    via MSBuild's directory-walk convention. Keep this file tight; per-mod
    specifics (assembly references, publicize lists, manifest copy targets)
    belong in each mod's .csproj.

    The companion Directory.Build.targets verifies required environment
    variables and emits a clear error when they are missing.
  -->

  <PropertyGroup>
    <!-- Pinned to match the official tobspr-games/shapez2-mod-samples repo. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Keep mod builds quiet-but-honest. Individual mods can override. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Don't generate binding-redirect metadata in netstandard. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!--
    Re-export the three required environment variables as MSBuild properties
    so per-mod .csproj files can reference them as $(ShapezPath) etc. instead
    of peppering $(SPZ2_PATH) macros everywhere.

    If any of these resolve empty, Directory.Build.targets fails the build
    with an actionable message before MSBuild tries (and fails) to resolve
    reference assemblies.
  -->
  <!--
    Normalize SPZ2_SHIFTER to a DIRECTORY.

    Every mod csproj resolves Shifter as $(SPZ2_SHIFTER)\ShapezShifter.dll, and
    SmartCutter reaches sideways for $(SPZ2_SHIFTER)\..\3591335975\AssimpNet.dll,
    so the variable must name Shifter's *folder*, not the DLL itself. The game's
    set-modding-env-vars launch flag has been seen setting it to the full .dll
    path, which produces a bogus ...\ShapezShifter.dll\ShapezShifter.dll HintPath and
    then a cascade of CS0246 errors (ShapezShifter, IRewirer, RewirerHandle,
    IBuildingsRewirer) that reads exactly like a Shifter API break but is only a
    bad path.

    A property defined here overrides the environment variable for the whole
    build, so accepting either form costs one condition and fixes every mod at
    once. Do NOT "fix" this by editing HintPaths per project.

    Limitation: this only normalizes the ENVIRONMENT variable. A value passed as
    an MSBuild global property (-p:SPZ2_SHIFTER=...) cannot be overridden from a
    project file, so the .dll form still fails there. Pass the directory when
    using -p:.
  -->
  <PropertyGroup Condition="'$(SPZ2_SHIFTER)' != '' AND $(SPZ2_SHIFTER.ToLowerInvariant().EndsWith('.dll'))">
    <SPZ2_SHIFTER>$([System.IO.Path]::GetDirectoryName('$(SPZ2_SHIFTER)'))</SPZ2_SHIFTER>
  </PropertyGroup>

  <PropertyGroup>
    <ShapezPath>$(SPZ2_PATH)</ShapezPath>
    <ShapezPersistent>$(SPZ2_PERSISTENT)</ShapezPersistent>
    <ShapezShifter>$(SPZ2_SHIFTER)</ShapezShifter>
  </PropertyGroup>

  <!--
    Output-root helper for mod projects. Each mod csproj opts into the
    "land in the game's mods/ directory" convention by setting:

      <PropertyGroup>
        <OutputPath>$(ShapezModOutputRoot)$(MSBuildProjectName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      </PropertyGroup>

    We don't set OutputPath centrally because MSBuild's evaluation order
    bakes the SDK's bin\Debug\... path early; a per-csproj override is both
    more reliable and more explicit than a conditional-in-props scheme.
    Test projects and tooling simply don't set OutputPath and use the
    default bin\... location.
  -->
  <PropertyGroup Condition="'$(ShapezPersistent)' != ''">
    <ShapezModOutputRoot>$(ShapezPersistent)\mods\</ShapezModOutputRoot>
  </PropertyGroup>

</Project>
