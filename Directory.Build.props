<Project>

  <!--
    Shared MSBuild configuration for every mod in this workspace.

    Mod .csproj files under Mods/<ModName>/ inherit these settings automatically
    via MSBuild's directory-walk convention. Keep this file tight; per-mod
    specifics (assembly references, publicize lists, manifest copy targets)
    belong in each mod's .csproj.

    The companion Directory.Build.targets verifies required environment
    variables and emits a clear error when they are missing.
  -->

  <PropertyGroup>
    <!-- Pinned to match the official tobspr-games/shapez2-mod-samples repo. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Keep mod builds quiet-but-honest. Individual mods can override. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Don't generate binding-redirect metadata in netstandard. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!--
    Re-export the three required environment variables as MSBuild properties
    so per-mod .csproj files can reference them as $(ShapezPath) etc. instead
    of peppering $(SPZ2_PATH) macros everywhere.

    If any of these resolve empty, Directory.Build.targets fails the build
    with an actionable message before MSBuild tries (and fails) to resolve
    reference assemblies.
  -->
  <PropertyGroup>
    <ShapezPath>$(SPZ2_PATH)</ShapezPath>
    <ShapezPersistent>$(SPZ2_PERSISTENT)</ShapezPersistent>
    <ShapezShifter>$(SPZ2_SHIFTER)</ShapezShifter>
  </PropertyGroup>

  <!--
    Output-root helper for mod projects. Each mod csproj opts into the
    "land in the game's mods/ directory" convention by setting:

      <PropertyGroup>
        <OutputPath>$(ShapezModOutputRoot)$(MSBuildProjectName)\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      </PropertyGroup>

    We don't set OutputPath centrally because MSBuild's evaluation order
    bakes the SDK's bin\Debug\... path early; a per-csproj override is both
    more reliable and more explicit than a conditional-in-props scheme.
    Test projects and tooling simply don't set OutputPath and use the
    default bin\... location.
  -->
  <PropertyGroup Condition="'$(ShapezPersistent)' != ''">
    <ShapezModOutputRoot>$(ShapezPersistent)\mods\</ShapezModOutputRoot>
  </PropertyGroup>

</Project>
