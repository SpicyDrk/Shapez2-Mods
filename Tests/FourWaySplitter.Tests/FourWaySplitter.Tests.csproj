<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain console "smoke check" app. Same pattern as Tests/HelloWorld.Tests/.
      Run via: dotnet run project Tests/FourWaySplitter.Tests/
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Not a Shapez mod: skip the env-var build-gate check and default output. -->
    <IsShapezMod>false</IsShapezMod>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
