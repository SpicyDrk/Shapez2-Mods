<Project Sdk="Microsoft.NET.Sdk">

  <!-- AnyLayerTrash mod. Build/packaging rationale: see CODE-NOTES.md.
       Inherits TargetFramework/LangVersion/Nullable from Directory.Build.props. -->

  <PropertyGroup>
    <OutputPath>$(ShapezModOutputRoot)$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- CS0436: duplicate IgnoresAccessChecksToAttribute (Publicizer + MonoMod.Utils);
         harmless. See CODE-NOTES.md. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ShapezShifter">
      <HintPath>$(SPZ2_SHIFTER)\ShapezShifter.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="SPZGameAssembly">
      <HintPath>$(SPZ2_PATH)\SPZGameAssembly.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(SPZ2_PATH)\Core.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Game.Core">
      <HintPath>$(SPZ2_PATH)\Game.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Modding">
      <HintPath>$(SPZ2_PATH)\Game.Core.Modding.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Coordinates">
      <HintPath>$(SPZ2_PATH)\Game.Core.Coordinates.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Rendering">
      <HintPath>$(SPZ2_PATH)\Game.Core.Rendering.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Game.Content.Features">
      <HintPath>$(SPZ2_PATH)\Game.Content.Features.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Content">
      <HintPath>$(SPZ2_PATH)\Game.Content.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Game 1.1 split building-definition types (BuildingDefinitionGroupId,
         MetaGameModeBuildings, GameBuildings, …) out of SPZGameAssembly into here. -->
    <Reference Include="Game.Core.Content">
      <HintPath>$(SPZ2_PATH)\Game.Core.Content.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Game 1.2 split blueprint types (BlueprintCurrency, reached indirectly via
         ModifyBuildingsPayload.BlueprintCurrencyModification) out into here.
         Reference only: the mod passes the value through without naming the type,
         so no Publicize entry is needed. -->
    <Reference Include="Game.Core.Blueprint">
      <HintPath>$(SPZ2_PATH)\Game.Core.Blueprint.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to match Shifter's shipped version (resolver binds to its copy;
         not redeployed). See CODE-NOTES.md. -->
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <Publicize Include="SPZGameAssembly" />
    <Publicize Include="Game.Core.Content" />
    <Publicize Include="Game.Core.Map.Model" />
    <Publicize Include="Game.Core.Map.Simulation" />
    <Publicize Include="Game.Content.Features" />
    <Publicize Include="Game.Content" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Steam Workshop publish (build folder + Steam/preview.png icon). Needs a
       POSIX shell, steamcmd, and STEAM_USERNAME. See CODE-NOTES.md / memory. -->
  <Target Name="SteamPublish" DependsOnTargets="Build">
    <Exec Command="sh ./Steam/SteamPublish.sh &quot;$([System.IO.Path]::GetFullPath('$(OutputPath)'))&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
