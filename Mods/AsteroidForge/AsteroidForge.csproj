<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AsteroidForge — sandbox/creative mod that places custom-shape MINEABLE
    asteroids onto the space map. The player authors a shape via shape code in a
    build-menu dialog, then clicks the space map to place; a vanilla extractor over
    the placed asteroid outputs that exact shape.

    Reference set mirrors AnyLayerTrash (proven-good superset). The publicized
    assemblies that matter here:
      - SPZGameAssembly       → GameResourcesMap (SuperChunksByCoordinate) +
                                ShapeMapResourceSource.
      - Game.Core.Map         → MapSuperChunk's private resource list / GC lookup /
                                type cache — we add a resource source to the LIVE
                                chunk in place (never rebuild + swap, which would
                                drop the chunk's island/platform registrations).
      - Game.Content.Features → ShapeDefinition (the model the patch carries).
      - Game.Orchestration    → PlacementToolbarElementData / toolbar element data.

    Shape identity is resolved canonically at place-time (GameHelper.Core.ShapeRegistry).

    Inherits TargetFramework (netstandard2.1) / LangVersion (9) / Nullable from
    the workspace Directory.Build.props.
  -->

  <PropertyGroup>
    <OutputPath>$(ShapezModOutputRoot)$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!--
      CS0436: Krafs.Publicizer and MonoMod.Utils both ship their own copy of
      IgnoresAccessChecksToAttribute. Compiler picks the Publicizer one (correct
      here) but warns per AssemblyInfo line. Harmless.
    -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ShapezShifter">
      <HintPath>$(SPZ2_SHIFTER)\ShapezShifter.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="SPZGameAssembly">
      <HintPath>$(SPZ2_PATH)\SPZGameAssembly.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(SPZ2_PATH)\Core.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Game.Core">
      <HintPath>$(SPZ2_PATH)\Game.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Modding">
      <HintPath>$(SPZ2_PATH)\Game.Core.Modding.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Coordinates">
      <HintPath>$(SPZ2_PATH)\Game.Core.Coordinates.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Rendering">
      <HintPath>$(SPZ2_PATH)\Game.Core.Rendering.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Drag preview: ALINE (com.arongranberg.aline) provides Drawing.CommandBuilder,
         returned by FrameDrawOptionsNoLOD.GetDebugDrawer(); Unity.Mathematics provides float3
         for the SolidPlane normal. Used by AsteroidPlacementPreview to paint the box
         footprint in-game (same draw path vanilla debug views use). -->
    <Reference Include="ALINE">
      <HintPath>$(SPZ2_PATH)\ALINE.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(SPZ2_PATH)\Unity.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Phase 2 UI: placement initiators, toolbar data, PlacementInitiatorId/ToolbarData
         (IPlacementInitiatorIdRegistry, PlacementToolbarElementData) live here. -->
    <Reference Include="Game.Orchestration">
      <HintPath>$(SPZ2_PATH)\Game.Orchestration.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Phase 2 UI: Core.Localization.IText / RawText for toolbar entry text. -->
    <Reference Include="Core.Localization">
      <HintPath>$(SPZ2_PATH)\Core.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Game.Content.Features">
      <HintPath>$(SPZ2_PATH)\Game.Content.Features.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Content">
      <HintPath>$(SPZ2_PATH)\Game.Content.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Phase 2 UI: Unity.Core.Prefabs.IPrefabInstanceProvider (HUDDialogStack ctor sig
         for the dialog-stack capture hook) + PrefabReference<T>. -->
    <Reference Include="Unity.Core">
      <HintPath>$(SPZ2_PATH)\Unity.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Legacy Input (UnityEngine.Input) for the placement cursor — left-click to place,
         Esc / right-click to cancel (AsteroidPlacementController). -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
  </PropertyGroup>

  <ItemGroup>
    <!--
      MonoMod.RuntimeDetour 25.3.0 matches what Shifter ships. Pinned so our
      compile-time IL targets the runtime types Shifter has already loaded; at
      launch the resolver binds to Shifter's copy (not redeployed — PrivateAssets
      all). Kept available for the Phase-1 spike's map/factory resolution hook.
    -->
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <Publicize Include="SPZGameAssembly" />
    <Publicize Include="Game.Content.Features" />
    <Publicize Include="Game.Content" />
    <!-- Phase 2 UI: construct PlacementToolbarElementData / reach toolbar element-data members. -->
    <Publicize Include="Game.Orchestration" />
    <!-- Phase 2 placement: MapSuperChunk (here, not SPZGameAssembly) keeps its resource
         list + GC lookup + type cache private. We add a resource source IN PLACE (rather
         than rebuilding the chunk, which would drop its island/platform registrations —
         the 2-arg ctor starts _Islands empty), so we need those fields. -->
    <Publicize Include="Game.Core.Map" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Build-menu entry icons (loaded at runtime via Shifter FileTextureLoader). -->
    <None Update="Resources/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
